{
  "name": "pvm",
  "version": "1.0.0",
  "private": true,
  "description": "PVM (PV-Manager) - standalone PV management web application for Home Assistant",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @pvm/shared && npm run build -w @pvm/server && npm run build -w @pvm/web",
    "setup": "bash scripts/pvm-setup.sh",
    "build:shared": "npm run build -w @pvm/shared",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @pvm/server\" \"npm run dev -w @pvm/web\"",
    "start": "npm run start -w @pvm/server",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "typecheck": "tsc -b --pretty",
    "test": "npm run test -w @pvm/server && npm run test -w @pvm/web",
    "test:server": "npm run test -w @pvm/server",
    "test:web": "npm run test -w @pvm/web",
    "test:e2e": "npm run test:e2e -w @pvm/web",
    "clean": "rimraf \"packages/*/dist\" \"apps/*/dist\" \"**/tsconfig.tsbuildinfo\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
