# ===== PVM environment configuration =====
# Copy to .env and adjust. NEVER commit the real .env file.

# --- Server ---
NODE_ENV=production
PVM_HOST=0.0.0.0
PVM_PORT=7000
PVM_LOG_LEVEL=INFO
# Secret used to sign PVM API tokens. MUST be changed in production (>= 32 chars).
PVM_API_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Database ---
PVM_DB_PATH=./data/pvm.sqlite
PVM_DATA_DIR=./data
PVM_ADDONS_DIR=./data/addons
PVM_LOGS_DIR=./data/logs

# --- Home Assistant ---
# Base URL of your Home Assistant instance, e.g. http://homeassistant.local:8123
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token (HA -> Profile -> Security -> Long-Lived Access Tokens)
HA_TOKEN=
# Reject HA URLs that are not local (loopback / RFC1918). Keep true unless you know why.
HA_LOCAL_ONLY=true

# --- Security ---
# Allowed CORS origins, comma separated. Empty = same-origin only.
PVM_CORS_ORIGINS=
PVM_RATE_LIMIT_MAX=300
PVM_RATE_LIMIT_WINDOW=60000

# --- Notifications (optional) ---
PVM_SMTP_URL=
PVM_EMAIL_FROM=
PVM_EMAIL_TO=
PVM_PUSH_WEBHOOK_URL=

# --- Frontend build (web) ---
VITE_PVM_API_BASE=/api
